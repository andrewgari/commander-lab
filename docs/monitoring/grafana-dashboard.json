{
 "title": "Redis\u2192PG transfer",
 "schemaVersion": 39,
 "panels": [
  {
   "id": 1,
   "type": "timeseries",
   "title": "Records read/s",
   "gridPos": {
    "h": 8,
    "w": 8,
    "x": 0,
    "y": 0
   },
   "targets": [
    {
     "expr": "sum(rate(transfer_records_total[5m]))",
     "refId": "A"
    }
   ]
  },
  {
   "id": 2,
   "type": "stat",
   "title": "Succeeded total",
   "gridPos": {
    "h": 8,
    "w": 8,
    "x": 8,
    "y": 0
   },
   "targets": [
    {
     "expr": "sum(transfer_records_succeeded_total)",
     "refId": "A"
    }
   ]
  },
  {
   "id": 3,
   "type": "stat",
   "title": "Error rate",
   "gridPos": {
    "h": 8,
    "w": 8,
    "x": 16,
    "y": 0
   },
   "targets": [
    {
     "expr": "sum(rate(transfer_records_failed_total[5m])) / clamp_min(sum(rate(transfer_records_total[5m])), 1e-9)",
     "refId": "A"
    }
   ]
  },
  {
   "id": 4,
   "type": "timeseries",
   "title": "Failures by reason",
   "gridPos": {
    "h": 8,
    "w": 8,
    "x": 0,
    "y": 8
   },
   "targets": [
    {
     "expr": "sum by (reason) (rate(transfer_records_failed_total[5m]))",
     "refId": "A"
    }
   ]
  },
  {
   "id": 5,
   "type": "timeseries",
   "title": "Batch p95 s",
   "gridPos": {
    "h": 8,
    "w": 8,
    "x": 8,
    "y": 8
   },
   "targets": [
    {
     "expr": "histogram_quantile(0.95, sum by (le) (rate(transfer_batch_duration_seconds_bucket[5m])))",
     "refId": "A"
    }
   ]
  },
  {
   "id": 6,
   "type": "stat",
   "title": "Since last success (s)",
   "gridPos": {
    "h": 8,
    "w": 8,
    "x": 16,
    "y": 8
   },
   "targets": [
    {
     "expr": "time() - max(transfer_last_success_timestamp_seconds)",
     "refId": "A"
    }
   ]
  }
 ]
}