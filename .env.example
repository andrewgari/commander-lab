# Reference for the variables below. Set them in the Portainer stack env, or export them in your shell
# (e.g. `set -a; . ./.env; set +a`) before running `make deploy-push` or the setup script; neither reads .env itself.
# Never commit real hosts.

# Oracle (Hermes gateway) base URL, e.g. http://<oracle-host>:8645. Empty disables oracle features.
ORACLE_URL=

# Portainer base URL for `make deploy-push` / setup script, e.g. http://<tower-host>:9009
PORTAINER_URL=

# Gitea base URL for the legacy setup_portainer_gitops.sh, e.g. http://<tower-host>:3004
GITEA_URL=
