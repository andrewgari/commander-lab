# Copy to .env (untracked) or set in the Portainer stack env. Never commit real hosts.

# Oracle (Hermes gateway) base URL, e.g. http://<oracle-host>:8645. Required in prod.
ORACLE_URL=

# Portainer base URL for `make deploy-push` / setup script, e.g. http://<tower-host>:9009
PORTAINER_URL=

# Gitea base URL for the legacy setup_portainer_gitops.sh, e.g. http://<tower-host>:3004
GITEA_URL=
