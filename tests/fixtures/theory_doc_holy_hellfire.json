  {
   "type": "thesis_pillars",
   "title": "Thesis",
   "data": {
    "thesis": "Kaalia drops a Dragon air force, backed by her Angels and Demons, straight into combat, and every Dragon arrival burns the table before the swing lands.",
    "pillars": [
     {
      "name": "Dragon Air Force",
      "description": "Big flying Dragons that pay off on entering or hitting, with the best Angels and Demons as a supporting wing."
     },
     {
      "name": "Haste and Extra Combats",
      "description": "Haste and extra combat phases so every Kaalia trigger and Dragon swing happens again."
     },
     {
      "name": "Commander Protection",
      "description": "Hexproof, protection and silence effects that keep Kaalia alive to attack."
     },
     {
      "name": "Trigger Doubling and Cheating",
      "description": "Copy attack and enter triggers and put fatties into play without paying for them."
     }
    ],
    "theme_fit": "Kaalia already cheats Dragons, so the theme just changes which of her three types carries the payload."
   }
  },
